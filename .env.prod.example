# ---------------------------------------------------------------------------
# Modèle de variables pour la production sur la VM.
# Copier en ".env" (que Docker Compose lit automatiquement) puis REMPLIR.
#   cp .env.prod.example .env
# NE JAMAIS committer le fichier ".env" rempli (il est git-ignoré).
# ---------------------------------------------------------------------------

# --- Base de données PostgreSQL ---
POSTGRES_DB=musclemap
POSTGRES_USER=musclemap
# Mettre un mot de passe FORT (ex. openssl rand -base64 24) :
POSTGRES_PASSWORD=change-me-strong-password

# --- Secret de signature des JWT (>= 32 octets aléatoires) ---
# Générer :  openssl rand -base64 48
MUSCLEMAP_JWT_SECRET=change-me-with-openssl-rand-base64-48

# --- Identifiant client Google (le MÊME que celui du frontend) ---
# Laisser vide => /auth/google renvoie 503, mais email/mot de passe marche.
MUSCLEMAP_GOOGLE_CLIENT_ID=

# --- Domaine public du frontend (pour CORS) ---
# Ex. https://musclemap.exemple.com
MUSCLEMAP_CORS_ALLOWED_ORIGINS=https://musclemap.exemple.com

# --- Taille du pool de connexions DB ---
DB_POOL_MAX=5
